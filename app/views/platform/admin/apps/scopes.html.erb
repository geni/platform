<%= render :partial => "/platform/admin/common/header" %>
<%= render :partial => "tabs" %>

<% unless Platform::Config.enable_scopes? %>
  <p style="color:#a3121a;font-weight:bold;margin:1em 0;">
    <%= tr("OAuth scopes are currently disabled (enable_scopes is false). Scopes listed here are not offered to developers and do not narrow any token's authority. Application capability flags are managed separately, on each application's own page.", 'Admin scopes page warning') %>
  </p>
<% end %>

<%= will_filter(@scopes) %>

<%=link_to_function("+ Add scope", "tr8nLightbox.show('/platform/admin/apps/lb_scope', {\"height\":300})")%>

<%= will_filter_table_tag(@scopes, :columns => [
	[:icon,	lambda{|s|
		image_tag(s.icon_url, :style => "width:16px;height:16px;")
	}, 'width:20px'],

	:keyword, :description, :updated_at,

  [:actions, lambda{|s|
      html = []
   	  html << link_to_function("edit", "tr8nLightbox.show('/platform/admin/apps/lb_scope?scope_id=#{s.id}', {\"height\":300})")
   	  html << link_to("delete", {:action => :delete_scope, :scope_id => s.id}, :confirm => "Are you sure you want to delete this scope?")
      html.join(" | ").html_safe
  }, 'padding:5px;text-align:right;white-space:nowrap;']

]) %>

<%= render :partial => "/platform/admin/common/footer" %>
