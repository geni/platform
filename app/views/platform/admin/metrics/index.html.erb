<%= render partial: "/platform/admin/common/header" %>
<%= render partial: "tabs" %>

<%# Both helpers take the result collection, not the filter: Platform::ApplicationHelper's
    versions read #wf_filter off what they are given, and that is set by
    WillFilter::Filter#results.  Handed the filter itself they read nil. %>
<%= will_filter(@metrics.results) %>
<%= will_filter_table_tag(@metrics.results, columns: [
  :id, [:type, lambda{|obj| obj.class.name}], :interval, :application_id, :active_user_count, :new_user_count, :created_at
]) %>

<%= render partial: "/platform/admin/common/footer" %>
