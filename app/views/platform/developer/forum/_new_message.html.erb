<div class="section_title">
  <%=tr("Reply to This Discussion") %>
	<a name="reply_message">&nbsp;</a>
</div>

<div class="section_box colored">
  <% form_tag({:action => :topic}, {:method => :post, :id => "forum_topic_form"}) do %>
    <%=hidden_field_tag(:topic_id, @topic.id)%>

    <table style="width:99%">
      <tr>
        <td style="width:80px; text-align:right; padding-right:10px; font-weight:bold;">
          <%=tr("Your Reply:") %>
        </td>
        <td>
          <%=text_area_tag(:message, "", :style=>"width:99%; height:70px")%>
        </td>
      </tr>
    </table>

    <div style="padding-top:20px; padding-bottom:10px;text-align:center">
        <button type="submit" id="submit-reply" class="translator_btn translator_submit_btn">
            <span><%=tr("Reply to This Discussion")%></span>
        </button>
    </div>
  <% end %>

</div>

<% javascript_tag do %>
	document.addEventListener("DOMContentLoaded", function() {
    var element = document.getElementById('submit-reply');
    if (element) {
      element.addEventListener('click', function(event) {
        event.preventDefault();
        Platform.Effects.submit('forum_topic_form');
      });
    }
	}
<% end %>