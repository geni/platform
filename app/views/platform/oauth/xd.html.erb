<!doctype html>
<html>
  <head>
    <title>XD</title>
  </head>
  <body>
    <% javascript_tag do %>
			function sendFragment() {
				(window.opener || window.parent || window.top).postMessage("<%= params.to_query -%>", "*");
			}

      document.addEventListener("DOMContentLoaded", sendFragment);
    <% end %>
  </body>
</html>