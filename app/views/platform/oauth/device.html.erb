<%#
  Step one of the device grant for the human: type the code the application showed you.

  There is deliberately no link that carries the code.  RFC 8628 section 3.3.1 makes
  verification_uri_complete optional, and it is the piece that turns device-code phishing into a
  single tap -- a victim who follows a link never types the code and never reads this page.  The
  typing is the point.
-%>
<div style="max-width:30em;margin:3em auto;font:14px/1.5 -apple-system,'Segoe UI',Helvetica,sans-serif;">
  <h1 style="font-size:1.3em;"><%= tr('Connect an application', 'Device grant page heading') %></h1>

  <% if @error %>
    <p style="color:#a3121a;font-weight:600;"><%= h(@error) %></p>
  <% end %>

  <p><%= tr('Enter the code shown by the application you are connecting.', 'Device grant instructions') %></p>

  <% form_tag({:controller => '/platform/oauth', :action => :device}) do %>
    <%= text_field_tag 'user_code', nil,
                       :autocomplete  => 'off',
                       :autocapitalize => 'characters',
                       :spellcheck    => 'false',
                       :placeholder   => 'XXXX-XXXX',
                       :style         => 'font-family:monospace;font-size:20px;letter-spacing:.12em;' \
                                         'padding:.5em;width:100%;text-transform:uppercase;' \
                                         'border:1px solid #ccc;border-radius:4px;' %>

    <p><%= submit_tag(tr('Continue', 'Device grant submit button'), :class => 'button super blue large') %></p>
  <% end %>

  <p style="color:#666;font-size:13px;">
    <%= tr('The code is not case sensitive and the dash is optional.', 'Device grant code format note') %>
  </p>
</div>
