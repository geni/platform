<% form_tag('/oauth/authorize', :id => 'auth_form') do %>
  <%= hidden_field_tag "response_type", @response_type%>
  <%= hidden_field_tag "client_id", params[:client_id]%>
  <%= hidden_field_tag "redirect_url", @redirect_url %>
  <%= hidden_field_tag "state", params[:state] %>
  <%= hidden_field_tag "scope", @scope %>
  <%= hidden_field_tag "origin", params[:origin]%>
  <%= hidden_field_tag "callback", params[:callback]%>
  <%= hidden_field_tag "display", @display%>
  <%= hidden_field_tag 'authorize', 1 %>
<% end %>

<% javascript_tag do %>
  function doAccept() {
    var tosEl = document.getElementById('tos-accepted');

    if( tosEl && !tosEl.checked ) {
      var tosRow = document.querySelector('.platform-authorize__tos-row');
      if (tosRow) tosRow.style.display = 'block';
      return false;
    } else {
      return document.getElementById('auth_form').submit();
    }
  }

  document.addEventListener("DOMContentLoaded", function() {
    var element = document.getElementById('auth-do-accept');
    if (element) {
      element.addEventListener('click', function(event) {
        var authEl = document.getElementById('authorize');
        if (authEl) authEl.value = 1;
        if (doAccept() == false) {
          event.preventDefault();
        }
      });
    }

    var element = document.getElementById('auth-do-cancel');
    if (element) {
      element.addEventListener('click', function(event) {
        event.preventDefault();
        var authEl = document.getElementById('authorize');
        if (authEl) authEl.value = 0;
        document.getElementById('auth_form').submit();
      });
    }
  });
<% end %>
